 "lines": [
  {
   "id": "001",
   "role": "devil",
   "text": "你又被我騙了！判賠十六萬四千元，同學的頭和肩膀都受傷了，你的爸爸媽媽也要一起賠！",
   "instruct": "得意地大笑、嘲諷"
  },
  {
   "id": "002",
   "role": "nar",
   "text": "下課了，你和小凱在籃球場邊玩球。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "003",
   "role": "xiaokai",
   "text": "哎呀，我踢太用力，球飛到小宇那邊去了！",
   "instruct": "有點懊惱地喊"
  },
  {
   "id": "004",
   "role": "nar",
   "text": "小宇撿起球，看了你們一眼，抱著球轉身就走。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "005",
   "role": "teacher",
   "text": "你們好好說，球沒拿回來，也不要生氣吵架喔。",
   "instruct": "溫和地提醒"
  },
  {
   "id": "006",
   "role": "devil",
   "text": "他一定是故意的！去追他，把球搶回來！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "007",
   "role": "nar",
   "text": "你握緊了拳頭，胸口悶悶的，越想越生氣。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "008",
   "role": "devil",
   "text": "握緊拳頭，跟上去，叫他把球還你！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "009",
   "role": "devil",
   "text": "別讓他跑掉！貼近一點，跟緊他！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "010",
   "role": "devil",
   "text": "貼著他的腳跟，緊緊跟著！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "011",
   "role": "xiaoyu",
   "text": "好痛……我的頭，還有肩膀……好痛……",
   "instruct": "痛苦地哭著說"
  },
  {
   "id": "012",
   "role": "teacher",
   "text": "小宇，先不要動！老師馬上叫救護車，也通知你們的家長。",
   "instruct": "緊張、急切但鎮定"
  },
  {
   "id": "014",
   "role": "me_b",
   "text": "我只是想把球拿回來……我沒有想要他受傷……",
   "instruct": "很內疚，快要哭出來"
  },
  {
   "id": "015",
   "role": "me_g",
   "text": "我只是想把球拿回來……我沒有想要他受傷……",
   "instruct": "很內疚，快要哭出來"
  },
  {
   "id": "016",
   "role": "devil",
   "text": "是他拿走你的球，是他先不對，不關你的事。",
   "instruct": "壓低聲音，冷冷地替人找藉口"
  },
  {
   "id": "017",
   "role": "angel",
   "text": "就算對方先不對，也不能用追趕、貼近的方式討回來。生氣的時候，更要冷靜。",
   "instruct": "溫柔、親切，語重心長"
  },
  {
   "id": "018",
   "role": "angel",
   "text": "我讓時間倒轉，回到你剛剛握緊拳頭的時候。這一次，請你自己做出正確的選擇！",
   "instruct": "溫柔而堅定"
  },
  {
   "id": "019",
   "role": "nar",
   "text": "小宇抱著球走了，你握緊了拳頭，心跳好快。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "020",
   "role": "angel",
   "text": "這一次，你可以自己選。生氣的時候，想一想最先要做的事。",
   "instruct": "溫柔、親切，語重心長"
  },
  {
   "id": "021",
   "role": "nar",
   "text": "你一路追在他後面，越追越近，小宇緊張地加快了腳步。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "022",
   "role": "nar",
   "text": "你邊走邊罵，小宇回頭看你，腳步慌亂，你一步跟上，踩到他的鞋跟。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "023",
   "role": "nar",
   "text": "你走在他身後一直戳他，他閃躲時被你踩到鞋跟，整個人往旁邊倒下。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "024",
   "role": "teacher",
   "text": "怎麼了？你的臉色看起來不太好。",
   "instruct": "溫柔地關心"
  },
  {
   "id": "025",
   "role": "me_b",
   "text": "小宇把我們的球拿走了，我很生氣，可是我知道不能追過去。",
   "instruct": "努力壓住怒氣，慢慢地說"
  },
  {
   "id": "026",
   "role": "me_g",
   "text": "小宇把我們的球拿走了，我很生氣，可是我知道不能追過去。",
   "instruct": "努力壓住怒氣，慢慢地說"
  },
  {
   "id": "027",
   "role": "teacher",
   "text": "你先冷靜下來，做得很好。老師幫你去跟他說，把球拿回來。",
   "instruct": "溫和地肯定、稱讚"
  },
  {
   "id": "028",
   "role": "angel",
   "text": "答對了！生氣的時候先停下來，慢慢呼吸三秒，再去找老師。不追、不貼近、不動手，大家都平安。",
   "instruct": "開心、溫暖地稱讚"
  },
  {
   "id": "029",
   "role": "devil",
   "text": "你又被我騙了！石頭砸壞了好幾輛車，你和爸爸媽媽要一起賠 5 萬元！",
   "instruct": "得意地大笑、嘲諷"
  },
  {
   "id": "031",
   "role": "nar",
   "text": "午後，你和小凱在學校的圍牆邊玩。圍牆好高，上面是一整排磁磚。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "032",
   "role": "xiaokai",
   "text": "你看，地上好多小石頭！我們來比賽，誰丟得過這道牆！",
   "instruct": "興奮地大聲喊"
  },
  {
   "id": "033",
   "role": "devil",
   "text": "牆外面什麼都沒有啦！誰會在意？丟過去看看，一定很好玩！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "034",
   "role": "nar",
   "text": "你蹲下來，撿起一顆比手掌還小的石頭。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "035",
   "role": "devil",
   "text": "撿起石頭，握緊它！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "036",
   "role": "xiaokai",
   "text": "我先丟！你看我的！",
   "instruct": "興奮地大聲喊"
  },
  {
   "id": "037",
   "role": "devil",
   "text": "換你了！丟遠一點！用力一點！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "038",
   "role": "devil",
   "text": "用力把石頭丟過牆！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "039",
   "role": "nar",
   "text": "牆外傳來「砰、砰」的聲音。三輛停在路邊的車，被石頭砸出好幾道刮痕和小凹痕。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "040",
   "role": "teacher",
   "text": "你們兩個，剛剛是不是丟了石頭過去？車主已經報警了，老師通知家長帶你們去警察局。",
   "instruct": "緊張、急切但鎮定"
  },
  {
   "id": "041",
   "role": "nar",
   "text": "修理車子的費用，要由你和爸爸媽媽一起賠。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "042",
   "role": "me_b",
   "text": "我只是想試試看能不能丟過去……我不知道外面有車……",
   "instruct": "很內疚，快要哭出來"
  },
  {
   "id": "043",
   "role": "me_g",
   "text": "我只是想試試看能不能丟過去……我不知道外面有車……",
   "instruct": "很內疚，快要哭出來"
  },
  {
   "id": "044",
   "role": "devil",
   "text": "誰叫車子停在那裡？根本不關你的事。",
   "instruct": "壓低聲音，冷冷地替人找藉口"
  },
  {
   "id": "045",
   "role": "angel",
   "text": "看不到的地方，不代表沒有人、沒有車。丟出去的石頭，要為它砸到的東西負責。",
   "instruct": "溫柔、親切，語重心長"
  },
  {
   "id": "046",
   "role": "angel",
   "text": "我讓時間倒轉，回到你剛撿起石頭的時候。這一次，請你自己選。",
   "instruct": "溫柔而堅定"
  },
  {
   "id": "047",
   "role": "nar",
   "text": "你手上拿著一顆石頭，小凱在旁邊笑著等你。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "048",
   "role": "angel",
   "text": "這一次，你可以自己選。想一想，牆的那一邊，有什麼看不到的東西？",
   "instruct": "溫柔、親切，語重心長"
  },
  {
   "id": "049",
   "role": "nar",
   "text": "小石頭飛過圍牆，「叮」的一聲，打在車子上，留下一道刮痕。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "050",
   "role": "nar",
   "text": "你想丟向空地，可是牆太高，看不到對面，石頭落在車子的車頂上。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "051",
   "role": "nar",
   "text": "小凱不敢爬，你們沒看清楚就丟了。石頭落在牆外的車子上。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "052",
   "role": "me_b",
   "text": "小凱，牆外面可能有車，看不到的地方不能丟。",
   "instruct": "認真、堅定地勸告"
  },
  {
   "id": "053",
   "role": "me_g",
   "text": "小凱，牆外面可能有車，看不到的地方不能丟。",
   "instruct": "認真、堅定地勸告"
  },
  {
   "id": "054",
   "role": "xiaokai",
   "text": "對耶，我都沒想到。好，我們不丟了。",
   "instruct": "恍然大悟，乖乖同意"
  },
  {
   "id": "055",
   "role": "teacher",
   "text": "你們兩個說得很對。我們一起把石頭放到草地邊，再去玩別的遊戲。",
   "instruct": "溫和地肯定、稱讚"
  },
  {
   "id": "056",
   "role": "angel",
   "text": "答對了！石頭不丟。圍牆那一邊你看不到，丟出去的石頭可能砸到車、也可能砸到人。",
   "instruct": "開心、溫暖地稱讚"
  },
  {
   "id": "057",
   "role": "devil",
   "text": "你又被我騙了！判賠 15 萬元，同學的頭受了傷，你的爸爸媽媽也要一起賠！",
   "instruct": "得意地大笑、嘲諷"
  },
  {
   "id": "064",
   "role": "devil",
   "text": "不要管她！直接跳下去，她會閃開的！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "065",
   "role": "devil",
   "text": "直接跳下去！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "066",
   "role": "xiaomei",
   "text": "好痛……我的頭……後面好痛……",
   "instruct": "痛苦地哭著說"
  },
  {
   "id": "067",
   "role": "teacher",
   "text": "小美，不要動！老師馬上叫救護車，也要通知家長。",
   "instruct": "緊張、急切但鎮定"
  },
  {
   "id": "069",
   "role": "me_b",
   "text": "我只是想跳下來而已……我沒有看到她……",
   "instruct": "很內疚，快要哭出來"
  },
  {
   "id": "070",
   "role": "me_g",
   "text": "我只是想跳下來而已……我沒有看到她……",
   "instruct": "很內疚，快要哭出來"
  },
  {
   "id": "077",
   "role": "nar",
   "text": "你一喊完就跳，小美嚇了一跳，根本來不及閃開。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "084",
   "role": "angel",
   "text": "小惡魔，不准你再騙人了！",
   "instruct": "生氣、情緒激動地大聲喝斥"
  },
  {
   "id": "085",
   "role": "devil",
   "text": "哇啊！好刺眼……我還會再回來的！",
   "instruct": "痛苦地慘叫，狼狽地逃走"
  },
  {
   "id": "086",
   "role": "angel",
   "text": "嗚……對不起，這一次我沒能保護大家……",
   "instruct": "難過、哽咽"
  },
  {
   "id": "087",
   "role": "nar",
   "text": "救護車很快就到了，把小宇送到醫院。小宇住院了好一段時間，還要請人照顧。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "088",
   "role": "nar",
   "text": "救護車很快就到了，把小宇送到醫院。",
   "instruct": "語氣低沉、嚴肅，帶點沉重"
  },
  {
   "id": "089",
   "role": "nar",
   "text": "下課時間，你和小凱來到操場前的司令台。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "090",
   "role": "xiaokai",
   "text": "司令台好高喔，站在上面可以看到整個操場！",
   "instruct": "興奮地大聲喊"
  },
  {
   "id": "091",
   "role": "devil",
   "text": "跑上司令台！從上面跳下來，一定超帥的！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "092",
   "role": "nar",
   "text": "司令台離地面大約一公尺，兩邊各有一座樓梯。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "093",
   "role": "devil",
   "text": "從樓梯一路跑上去！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
